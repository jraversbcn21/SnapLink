{
  "manifest_version": 3,
  "name": "SnapLink",
  "version": "1.3.0",
  "description": "Copy page URLs as rich links with the page title as display text — paste formatted links into Word, Excel, Notion, and more.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.atlassian.net/*",
    "*://*.atlassian.com/*",
    "https://jira.inditex.com/*",
    "*://*.linear.app/*",
    "*://github.com/*",
    "*://gitlab.com/*",
    "*://*.gitlab.com/*",
    "*://trello.com/*",
    "*://notion.so/*",
    "*://*.clickup.com/*",
    "*://*.asana.com/*",
    "*://*.zendesk.com/*",
    "*://*.shortcut.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-ticket-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Ctrl+Shift+S"
      },
      "description": "Copy ticket as formatted link silently"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapLink — Copy as Rich Link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.atlassian.com/*",
        "https://jira.inditex.com/*",
        "*://*.linear.app/*",
        "*://github.com/*",
        "*://gitlab.com/*",
        "*://*.gitlab.com/*",
        "*://trello.com/*",
        "*://notion.so/*",
        "*://*.clickup.com/*",
        "*://*.asana.com/*",
        "*://*.zendesk.com/*",
        "*://*.shortcut.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
