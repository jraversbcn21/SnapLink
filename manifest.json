{
  "manifest_version": 3,
  "name": "SnapLink",
  "version": "1.7.0",
  "description": "Copy page URLs as rich links with the page title as display text — paste formatted links into Word, Excel, Notion, and more.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-ticket-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Ctrl+Shift+L"
      },
      "description": "Copy ticket as formatted link silently"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapLink — Copy as Rich Link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
